# LiveKit (must match the local LiveKit server configuration)
LIVEKIT_API_KEY=devkeytestsec453634dfgetsdfasdbfabsdm,fbasmdbfm,asbdfasbdf
LIVEKIT_API_SECRET=testsecretdevkeysdfklasdjkfhaksdfasdfgasjkdfksddsfhskdf
LIVEKIT_BIND=127.0.0.1
LIVEKIT_PUB_URL=wss://archcraft.tail794912.ts.net/rtc

